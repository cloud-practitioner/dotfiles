# Git and SSH identities for the Linux workstation and devcontainer.
# See README's Git identity section for setup and validation rules.
#
# Copy to ~/.config/dotfiles/identity.env, fill it in, then switch (./rebuild.sh):
#   install -D -m 600 ~/.dotfiles/identity.env.example ~/.config/dotfiles/identity.env
#
# This file holds NO secrets: names, emails, the forge owners (org or user)
# each identity owns, and the PATH of each private key. Never put a key,
# token, or password here. The switch never creates keys; it checks that
# each key exists and tells you the ssh-keygen command to run if one is
# missing.
#
# Format: KEY=value lines only. The file is parsed, never sourced, so shell
# syntax ($(...), backticks, variables) is not expanded.

# Space-separated identity labels. Each label needs the _HOST, _OWNERS,
# _KEY, _NAME and _EMAIL lines below; _ALIAS is optional.
IDENTITIES="gh_personal gh_work bb_work"

# For remote-URL matching and SSH versus HTTPS pushes, see README's Git identity section.
gh_personal_HOST=github.com
gh_personal_OWNERS="your-github-user your-personal-org"
gh_personal_KEY=~/.ssh/id_ed25519_gh_personal
gh_personal_NAME="Your Name"
gh_personal_EMAIL="you@personal.example"
# Optional legacy SSH alias (git@<alias>:owner/repo) kept for old remotes.
gh_personal_ALIAS=github.com-personal

gh_work_HOST=github.com
gh_work_OWNERS="your-work-org"
gh_work_KEY=~/.ssh/id_ed25519_gh_work
gh_work_NAME="Your Name"
gh_work_EMAIL="you@work.example"
gh_work_ALIAS=github.com-work

bb_work_HOST=bitbucket.org
bb_work_OWNERS="your-bitbucket-workspace"
bb_work_KEY=~/.ssh/id_ed25519_bb_work
bb_work_NAME="Your Name"
bb_work_EMAIL="you@work.example"
bb_work_ALIAS=bitbucket.org-work
